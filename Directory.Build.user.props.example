    <!-- false: build against the NuGet packages even though there's a BitMagic checkout -->
    <UseLocalBitMagic>false</UseLocalBitMagic>

    <!-- a BitMagic checkout somewhere other than ../BitMagic -->
    <!-- <BitMagicRoot>D:\Work\BitMagic\</BitMagicRoot> -->
  </PropertyGroup>
</Project>
