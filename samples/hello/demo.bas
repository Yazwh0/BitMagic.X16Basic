10 REM *** BITMAGIC X16 BASIC DEMO ***
20 COLOR 1,6:CLS
30 NAME$="COMMANDER X16":PTS=0:LIVES%=3:SPEED=1.5
40 DEF FN SQ(X)=X*X
50 DIM SHIP$(3),GRID%(4,4),HIGH(5)
60 GOSUB 1000:REM TITLE
70 REM --- READ THE SHIPS ---
80 FOR I=0 TO 3:READ SHIP$(I):NEXT I
90 GOSUB 2000:REM LIST THE SHIPS
100 REM --- FILL THE GRID ---
110 FOR Y=0 TO 4:FOR X=0 TO 4
120 GRID%(X,Y)=FN SQ(X)+Y*10
130 NEXT X,Y
140 GOSUB 3000:REM DRAW THE GRID
150 REM --- PLAY SOME ROUNDS ---
160 FOR ROUND=1 TO 5
170 GOSUB 4000:REM PLAY A ROUND
180 HIGH(ROUND)=PTS
190 NEXT ROUND
200 GOSUB 5000:REM RESULTS
210 PRINT:PRINT "COUNTING, WATCH X16 BASIC LIVE..."
220 FOR T=1 TO 20000:C=T AND 255:NEXT T
230 PRINT:PRINT "THANKS FOR PLAYING, ";NAME$
240 END

1000 REM *** TITLE ***
1010 PRINT "{WHT}";NAME$;" DEMO{LBLU}"
1020 PRINT "LIVES:";LIVES%;"  SPEED:";SPEED
1030 PRINT
1040 RETURN

2000 REM *** LIST THE SHIPS ***
2010 PRINT "SHIPS:"
2020 FOR I=0 TO 3
2030 PRINT "  ";I+1;": ";SHIP$(I);
2040 GOSUB 2500
2050 NEXT I
2060 RETURN

2500 REM *** PRINT A SHIP'S LENGTH ***
2510 PRINT " (";LEN(SHIP$(I));"LETTERS )"
2520 RETURN

3000 REM *** DRAW THE GRID ***
3010 PRINT:PRINT "GRID:"
3020 FOR Y=0 TO 4:ROW$=""
3030 FOR X=0 TO 4:ROW$=ROW$+RIGHT$("    "+STR$(GRID%(X,Y)),4):NEXT X
3040 PRINT ROW$
3050 NEXT Y
3060 RETURN

4000 REM *** PLAY A ROUND ***
4010 DICE=INT(RND(1)*10)+1
4020 PTS=PTS+DICE*SPEED
4030 IF DICE<3 THEN LIVES%=LIVES%-1:GOSUB 4500
4040 PRINT "ROUND";ROUND;": ROLLED";DICE;" POINTS";PTS
4050 SPEED=SPEED+0.25
4060 RETURN

4500 REM *** LOST A LIFE ***
4510 PRINT "{RED}  OUCH! LIVES LEFT:";LIVES%;"{LBLU}"
4520 RETURN

5000 REM *** RESULTS ***
5010 PRINT:PRINT "SCORE AFTER EACH ROUND:"
5020 FOR I=1 TO 5:PRINT "  ROUND";I;HIGH(I):NEXT I
5030 BEST=0:FOR I=1 TO 5:IF HIGH(I)>BEST THEN BEST=HIGH(I)
5040 NEXT I
5050 PRINT "BEST:";BEST
5060 RETURN

9000 DATA VIPER,COBRA,PYTHON,ASP
