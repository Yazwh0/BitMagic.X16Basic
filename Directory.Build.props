<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

  </PropertyGroup>

  <!-- Your own settings for this machine, eg UseLocalBitMagic or BitMagicRoot. Not in git. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.user.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props')" />

  <PropertyGroup>
    <!--
      true: reference the BitMagic projects from a checkout (BitMagicRoot, ../BitMagic by default).
      false: use the published NuGet packages instead, at BitMagicPackageVersion.
      Left unset it's true if there's a checkout there and false if not (eg in CI). Set it in
      Directory.Build.user.props, the environment, or on the command line (-p:UseLocalBitMagic=false).
    -->
    <BitMagicRoot Condition="'$(BitMagicRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'BitMagic'))</BitMagicRoot>
    <UseLocalBitMagic Condition="'$(UseLocalBitMagic)' == '' and Exists('$(BitMagicRoot)BitMagic.X16Debugger\BitMagic.X16Debugger\BitMagic.X16Debugger.csproj')">true</UseLocalBitMagic>
    <UseLocalBitMagic Condition="'$(UseLocalBitMagic)' == ''">false</UseLocalBitMagic>
    <BitMagicPackageVersion Condition="'$(BitMagicPackageVersion)' == ''">0.1.92</BitMagicPackageVersion>

    <!-- Where the ROM tests find rom.bin and the .sym files. -->
    <X16RomDirectory Condition="'$(X16RomDirectory)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'x16-rom', 'build', 'x16'))</X16RomDirectory>
  </PropertyGroup>

  <!-- NuGet packages: only src/ is packed, see IsPackable in the test projects -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Authors>Yazwh0</Authors>
    <Company>BitMagic</Company>
    <PackageProjectUrl>https://bitmagic.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Yazwh0/BitMagic.X16Basic</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>commander-x16;x16;basic;6502;bitmagic;debugger</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
